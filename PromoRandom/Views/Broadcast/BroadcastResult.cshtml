@{
    ViewData["Title"] = "Результат рассылки";
}

<div class="container py-4">
    <div class="alert alert-success">
        <h4 class="alert-heading"><i class="fas fa-check-circle"></i> Рассылка завершена!</h4>
        <p>
            Успешно отправлено: <strong>@ViewBag.SuccessCount</strong> из <strong>@ViewBag.TotalCount</strong> пользователей
        </p>
        <hr>
        <p class="mb-0">
            <a href="@Url.Action("SendBroadcast")" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Вернуться к рассылке
            </a>
        </p>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            Отправленное сообщение
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(ViewBag.PhotoUrl))
            {
                <div class="text-center mb-3">
                    <img src="@ViewBag.PhotoUrl" class="img-fluid rounded" alt="Attached image" style="max-height: 300px;">
                </div>
            }

            <div class="border p-3 bg-light">
                @Html.Raw(ViewBag.Message.Replace("\n", "<br>"))
            </div>
        </div>
    </div>
</div>