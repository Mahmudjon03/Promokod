@{
    Layout = null; // Убираем стандартный layout
}

<!DOCTYPE html>
<html>
<head>
    <title>Розыгрыш завершен</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="modal fade show" id="giveEndedModal" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Розыгрыш завершен</h5>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-trophy fa-5x text-warning mb-4"></i>
                    <h3>Все призы разыграны!</h3>
                    <p class="lead mt-3">Спасибо за участие в розыгрыше.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <a href="/" class="btn btn-primary">
                        <i class="fas fa-home mr-2"></i> На главную
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background-color: rgba(0,0,0,0.5);
        }

        .modal {
            background-color: rgba(0,0,0,0.5);
        }
    </style>
</body>
</html>