@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>«ИМКОН» - Шоу</title>

    <!-- Font Awesome for fas fa-* icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="~/css/site-styles.css" rel="stylesheet" />

    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="bg-dark text-white py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a href="/Site/Index" class="d-flex align-items-center text-white text-decoration-none">
                    <img src="~/images/logo.png" alt="«ИМКОН ШОУ»" class="logo-img me-2">
                    <h1 class="h3 m-0 text-uppercase logo-title">«ИМКОН ШОУ»</h1>
                </a>
            </div>

            <div class="d-flex align-items-center">
                <div class="language-switcher">
                    <a href="/Site/SetLanguage?culture=ru&returnUrl=@Context.Request.Path"
                       class="@(CultureInfo.CurrentUICulture.Name.StartsWith("ru") ? "active" : "")"
                       title="Русский">
                        <img src="~/images/flag-ru.png" alt="Русский" />
                    </a>
                    <a href="/Site/SetLanguage?culture=tg&returnUrl=@Context.Request.Path"
                       class="@(CultureInfo.CurrentUICulture.Name.StartsWith("tg") ? "active" : "")"
                       title="Тоҷикӣ">
                        <img src="~/images/flag-tj.png" alt="Тоҷикӣ" />
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-light text-center py-4 mt-auto">
        &copy; 2025 Магазин «Имкон». Все права защищены.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        AOS.init({ once: true });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>