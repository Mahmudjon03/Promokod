@model IEnumerable<Article>
@{
    ViewData["Title"] = "Управление новостями";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="h3 font-weight-bold mb-2">Управление новостями</h1>
            <p class="text-muted mb-0">Всего новостей: @Model.Count()</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow">
            <i class="fas fa-plus-circle mr-2"></i>Добавить новость
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-newspaper fa-4x text-muted mb-3"></i>
            <h4 class="mb-3">Новости не найдены</h4>
            <p class="text-muted">Создайте свою первую новость</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="fas fa-plus mr-1"></i> Создать новость
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var article in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm article-card">
                        @if (!string.IsNullOrEmpty(article.ImagePath))
                        {
                            <img src="@article.ImagePath" class="card-img-top" alt="@article.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-2">
                                <a asp-controller="Site" asp-action="NewsDetails" asp-route-id="@article.Id" class="text-dark text-decoration-none">
                                    @article.Title
                                </a>
                            </h5>

                            <div class="d-flex justify-content-between text-muted small">
                                <span>
                                    <i class="far fa-calendar mr-1"></i>@article.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                                <span>
                                    <i class="far fa-eye mr-1"></i>@article.Views
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 d-flex justify-content-end">
                            <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary mr-2" title="Редактировать">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@article.Id" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить"
                                        onclick="return confirm('Вы уверены, что хотите удалить эту новость?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
