@{
    ViewData["Title"] = "Настройки системы";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-cog me-2"></i> Настройки системы</h2>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Параметры промоакций</h5>
        </div>
        <div class="card-body">
            <form id="settingsForm" method="post" asp-action="UpdateSettings">
                <div class="form-group">
                    <label for="minimumAmount">Минимальная сумма</label>
                    <input type="number" class="form-control" id="minimumAmount" name="minimumAmount"
                           value="@ViewBag.MinimumAmount" min="0" required>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i> Сохранить изменения
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#settingsForm').on('submit', function(e) {
                e.preventDefault();

                $.ajax({
                    url: $(this).attr('action'),
                    method: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        toastr.success('Настройки успешно сохранены');
                    },
                    error: function() {
                        toastr.error('Произошла ошибка при сохранении');
                    }
                });
            });
        });
    </script>

    <style>
        /* Settings Page Styles */

        .toast-success {
            background-color: #2e7d32 !important; /* насыщенный тёмно-зелёный */
            color: #ffffff !important; /* белый текст */
            border-left: 6px solid #66bb6a;
        }

        .toast-error {
            background-color: #c62828 !important; /* насыщенный тёмно-красный */
            color: #ffffff !important; /* белый текст */
            border-left: 6px solid #ef5350;
        }

        .toast-success, .toast-error {
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            border-radius: 6px;
            font-weight: 500;
        }


        .settings-card {
            border-radius: 10px;
            overflow: hidden;
        }

            .settings-card .card-header {
                font-weight: 600;
                padding: 1rem 1.5rem;
            }

            .settings-card .card-body {
                padding: 2rem;
            }

        #minimumAmount {
            max-width: 300px;
            font-weight: 500;
        }

        /* Toastr notifications positioning */
        .toast-top-right {
            top: 70px;
            right: 12px;
        }

        @@media (max-width: 768px) {
            .settings-card .card-body

        {
            padding: 1.5rem;
        }

        }
    </style>
}