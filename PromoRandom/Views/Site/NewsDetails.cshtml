@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@model Article
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_SiteLayout.cshtml";

    var url = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("NewsDetails", "Site", new { id = Model.Id })}";
}

<div class="container py-2">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Заголовок и мета -->
            <h1 class="fw-bold mb-3 display-5">@Model.Title</h1>

            <div class="d-flex flex-wrap align-items-center text-muted mb-4">
                <div class="d-flex align-items-center me-4">
                    <i class="far fa-calendar me-2"></i>
                    <span>@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="d-flex align-items-center">
                    <i class="far fa-eye me-2"></i>
                    <span>@Model.Views @L["Views"]</span>
                </div>
            </div>

            <!-- Изображение -->
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="article-image mb-5 rounded-4 overflow-hidden shadow-sm">
                    <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title" class="img-fluid w-100"
                         style="height: 450px; object-fit: cover;" />
                </div>
            }

            <!-- Контент -->
            <div class="article-content mb-5 bg-white p-4 rounded-4 shadow-sm">
                @Html.Raw(Model.Content)
            </div>

            <!-- Поделиться -->
            <div class="share-section mb-5">
                <h5 class="fw-bold mb-3"><i class="fas fa-share-alt me-2"></i>@L["Share"]</h5>
                <div class="d-flex flex-wrap gap-2">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@url" target="_blank"
                       class="btn btn-outline-primary rounded-pill px-3 py-2">
                        <i class="fab fa-facebook-f me-2"></i> Facebook
                    </a>
                    <a href="https://t.me/share/url?url=@url&text=@Model.Title" target="_blank"
                       class="btn btn-outline-primary rounded-pill px-3 py-2">
                        <i class="fab fa-telegram-plane me-2"></i> Telegram
                    </a>
                    <a href="https://twitter.com/intent/tweet?url=@url&text=@Model.Title" target="_blank"
                       class="btn btn-outline-info rounded-pill px-3 py-2">
                        <i class="fab fa-twitter me-2"></i> Twitter
                    </a>
                    <a href="https://api.whatsapp.com/send?text=@Model.Title%20@url" target="_blank"
                       class="btn btn-outline-success rounded-pill px-3 py-2">
                        <i class="fab fa-whatsapp me-2"></i> WhatsApp
                    </a>
                    <button class="btn btn-outline-secondary rounded-pill px-3 py-2 copy-link-btn"
                            data-url="@url">
                        <i class="fas fa-link me-2"></i> @L["CopyLink"]
                    </button>
                </div>
            </div>       
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".copy-link-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const url = this.dataset.url;
                navigator.clipboard.writeText(url).then(() => {
                    this.innerHTML = '<i class="fas fa-check me-2"></i>@L["Copied"]';
                    setTimeout(() => {
                        this.innerHTML = '<i class="fas fa-link me-2"></i> @L["CopyLink"]';
                    }, 2000);
                });
            });
        });
    </script>
}
