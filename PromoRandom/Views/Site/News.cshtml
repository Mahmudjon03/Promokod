@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.RegularExpressions
@using System.Web
@inject IViewLocalizer L

@model IEnumerable<Article>
@{
    ViewData["Title"] = L["News"]; // Локализованный заголовок страницы
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="container py-5">
    <!-- Заголовок -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">@L["LatestNews"]</h1>
        <div class="divider mx-auto"></div>
        <p class="lead text-muted">@L["LatestNewsDescription"]</p>
    </div>

    @if (!Model.Any())
    {
        <!-- Пустой список -->
        <div class="text-center py-5">
            <i class="fas fa-newspaper fa-4x text-muted mb-3"></i>
            <h4 class="mb-3">@L["NoNewsFound"]</h4>
            <p class="text-muted">@L["NoNewsDescription"]</p>
        </div>
    }
    else
    {
        <!-- Список новостей -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var article in Model)
            {
                string rawContent = article.Content ?? "";
                string plainText = Regex.Replace(rawContent, "<.*?>", "");
                plainText = HttpUtility.HtmlDecode(plainText);
                string contentPreview = plainText.Length > 100 ? plainText.Substring(0, 100) + "..." : plainText;

                <div class="col">
                    <div class="card news-card h-100 border-0 shadow-sm">
                        <!-- Обёртка изображения -->
                        <div class="position-relative overflow-hidden rounded-top" style="height: 200px;">
                            <a href="@Url.Action("NewsDetails", "Site", new { id = article.Id })">
                                <img src="@Url.Content(article.ImagePath)" alt="@article.Title"
                                     class="img-fluid w-100 h-100" style="object-fit: cover; transition: transform 0.3s ease;">
                            </a>
                        </div>

                        <!-- Контент -->
                        <div class="card-body d-flex flex-column">
                            <div class="text-muted small mb-2 d-flex align-items-center">
                                <i class="far fa-calendar me-2"></i>
                                @article.CreatedAt.ToString("dd.MM.yyyy")
                                <span class="mx-2">•</span>
                                <i class="far fa-eye me-2"></i>
                                @article.Views
                            </div>

                            <h5 class="card-title fw-bold mb-2">
                                <a href="@Url.Action("NewsDetails", "Site", new { id = article.Id })"
                                   class="text-dark text-decoration-none stretched-link">
                                    @article.Title
                                </a>
                            </h5>

                            <p class="card-text text-muted" style="font-size: 0.95rem;">@contentPreview</p>
                        </div>

                        <!-- Кнопка "Читать" -->
                        <div class="card-footer bg-white border-0">
                            <a href="@Url.Action("NewsDetails", "Site", new { id = article.Id })"
                               class="btn btn-outline-primary w-100 rounded-pill">
                                <i class="fas fa-book-reader me-2"></i> Хондан
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .news-card {
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .news-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
            }

                .news-card:hover img {
                    transform: scale(1.05);
                }

        .divider {
            width: 60px;
            height: 4px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 10px;
            margin-bottom: 1rem;
        }
    </style>
}
