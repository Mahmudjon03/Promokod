@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model List<PromoRandom.ViewModels.WinnerStatModel>

@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-center">@L["Title"]</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            @L["NoData"]
        </div>
    }
    else
    {
        <div id="accordion">
            <!-- 🧠 Добавил обёртку -->
            @for (int index = 0; index < Model.Count; index++)
            {
                var giveaway = Model[index];
                var statusKey = giveaway.IsCompleted
                ? "Status_Completed"
                : DateTime.Now < giveaway.StartDate
                ? "Status_Pending"
                : "Status_Active";

                string collapseId = $"collapseGiveaway_{index}";
                bool isFirst = index == 0;

                <div class="card shadow mb-4">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@giveaway.GiveawayName</h5>
                            <small>
                                @String.Format(
                                         L["GiveawayPeriod"].Value,
                                         giveaway.StartDate.ToString("dd MMMM yyyy"),
                                         giveaway.EndDate.ToString("dd MMMM yyyy")
                                         )
                            </small>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-light text-dark me-2">@L[statusKey]</span>
                            <button class="btn btn-sm btn-light toggle-btn"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(isFirst ? "true" : "false")"
                                    aria-controls="@collapseId"
                                    title="Показать/Скрыть">
                                <i class="toggle-icon fas @(isFirst ? "fa-angle-up" : "fa-angle-down")"></i>
                            </button>
                        </div>
                    </div>

                    <div id="@collapseId" class="collapse @(isFirst ? "show" : "")" data-bs-parent="#accordion">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Приз</th>
                                            <th>Победитель</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in giveaway.Winners)
                                        {
                                            <tr>
                                                <td><span class="fw-bold">@w.PrizeName</span></td>
                                                <td>@w.WinnerName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div> <!-- 🧠 Закрытие обёртки -->
    }
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Обработчик для аккордеона
            document.querySelectorAll('.collapse').forEach(collapse => {
                collapse.addEventListener('show.bs.collapse', event => {
                    const target = event.target;
                    const button = document.querySelector(`[data-bs-target="#${target.id}"]`);
                    if (button) {
                        const icon = button.querySelector('.toggle-icon');
                        icon.classList.remove('fa-angle-down');
                        icon.classList.add('fa-angle-up');
                    }
                });

                collapse.addEventListener('hide.bs.collapse', event => {
                    const target = event.target;
                    const button = document.querySelector(`[data-bs-target="#${target.id}"]`);
                    if (button) {
                        const icon = button.querySelector('.toggle-icon');
                        icon.classList.remove('fa-angle-up');
                        icon.classList.add('fa-angle-down');
                    }
                });
            });
        });
    </script>
}


@section Styles {
    <style>
        .toggle-icon {
            transition: all 0.3s ease;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,.075);
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(0,0,0,.02);
        }

        .bg-dark {
            background-color: #343a40 !important;
        }

        .card-header.bg-dark {
            border-bottom: 1px solid rgba(0,0,0,.125);
        }
    </style>
}