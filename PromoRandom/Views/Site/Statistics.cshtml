@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model List<PromoRandom.ViewModels.WinnerStatModel>

@{
    ViewData["Title"] = L["Title"];
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">@L["Title"]</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4">
            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
            <h4>@L["NoData"]</h4>
        </div>
    }
    else
    {
        <div class="accordion" id="giveawayAccordion">
            @for (int index = 0; index < Model.Count; index++)
            {
                var giveaway = Model[index];
                var statusKey = giveaway.IsCompleted
                ? "Status_Completed"
                : DateTime.Now < giveaway.StartDate
                ? "Status_Pending"
                : "Status_Active";

                string collapseId = $"collapseGiveaway_{index}";
                bool isFirst = index == 0;

                <div class="accordion-item shadow mb-4 border-0">
                    <div class="accordion-header" id="heading_@index">
                        <button class="accordion-button bg-dark text-white p-3 @(isFirst ? "" : "collapsed")"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="@(isFirst ? "true" : "false")"
                                aria-controls="@collapseId">
                            <div class="d-flex justify-content-between w-100 align-items-center">
                                <div class="flex-grow-1 me-3">
                                    <h5 class="mb-1">@giveaway.GiveawayName</h5>
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        <small class="d-flex align-items-center">
                                            <i class="fas @(statusKey == "Status_Completed" ? "fa-calendar-check" : "fa-calendar-alt") me-1"></i>
                                            @giveaway.StartDate.ToString("dd MMMM yyyy") - @giveaway.EndDate.ToString("dd MMMM yyyy")
                                        </small>

                                    </div>
                                </div>
                                <div>
                                    <span class="badge @(statusKey == "Status_Completed" ? "bg-success" : statusKey == "Status_Active" ? "bg-warning" : "bg-info") me-2">
                                        @L[statusKey]
                                    </span>
                                </div>
                            </div>
                        </button>
                    </div>

                    <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")"
                         aria-labelledby="heading_@index"
                         data-bs-parent="#giveawayAccordion">
                        <div class="accordion-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-striped align-middle mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Статус</th>
                                            <th>Приз</th>
                                            <th>Победитель</th>
                                            <th>Имкон-код</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int counter = 1;
                                            foreach (var prize in giveaway.Winners)
                                            {
                                                var isWon = !string.IsNullOrEmpty(prize.WinnerName);
                                                <tr>
                                                    <td class="fw-bold">@(counter++)</td>
                                                    <td>
                                                        @if (isWon)
                                                        {
                                                            <span class="badge bg-success">Разыгран</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Ожидает</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            @if (!string.IsNullOrEmpty(prize.ImagePath))
                                                            {
                                                                <img src="@prize.ImagePath"
                                                                     alt="@prize.PrizeName"
                                                                     class="me-2 d-none d-md-block"
                                                                     style="width: 60px; height: 60px; object-fit: cover;" />
                                                            }
                                                            <div>
                                                                <strong>@prize.PrizeName</strong>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (isWon)
                                                        {
                                                            <div class="d-flex align-items-center">
                                                                <i class="fas fa-user-circle me-2 text-primary"></i>
                                                                <span>@prize.WinnerName</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(prize.PromoCode))
                                                        {
                                                            <code class="bg-light p-1 rounded">@prize.PromoCode</code>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .accordion-button::after {
            content: '\f078'; /* Font Awesome chevron-down */
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            margin-left: auto;
            transition: transform 0.3s ease;
            color: #fff;
        }

        .accordion-button:not(.collapsed)::after {
            transform: rotate(180deg);
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
        }

        .accordion-item {
            border-radius: 0.5rem !important;
            overflow: hidden;
        }

        .table-striped > tbody > tr:nth-of-type(odd) > * {
            background-color: rgba(0,0,0,.015);
        }

        .table-hover > tbody > tr:hover > * {
            background-color: rgba(0,0,0,.03) !important;
        }

        .badge {
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        /* Адаптация для мобильных */
        @@media (max-width: 767.98px) {
            .accordion-button {
                padding: 0.75rem;
            }

                .accordion-button h5 {
                    font-size: 1rem;
                }

                .accordion-button small {
                    font-size: 0.75rem;
                }

            .table {
                font-size: 0.85rem;
            }

                .table th, .table td {
                    padding: 0.75rem 0.5rem;
                }

            .badge {
                font-size: 0.75rem;
                padding: 0.25em 0.4em;
            }

            .d-none.d-md-block {
                display: none !important;
            }
        }
    </style>
}